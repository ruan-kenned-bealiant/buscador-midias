[Unit]
Description=Buscador de mídias - publicador das seis filas (justiça por host e contrapressão)
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/ruan-aliant/Documentos/Projetos/buscador-midias
ExecStart=/home/ruan-aliant/Documentos/Projetos/buscador-midias/scripts/bm.sh pipeline serve --role publisher
Restart=on-failure
RestartSec=10
TimeoutStopSec=150
KillMode=control-group

[Install]
WantedBy=default.target
