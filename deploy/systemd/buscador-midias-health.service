[Unit]
Description=Buscador de mídias - saúde das fontes (inativa, exclui, recupera e troca o transporte dos links)
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/ruan-aliant/Documentos/Projetos/buscador-midias
ExecStart=/home/ruan-aliant/Documentos/Projetos/buscador-midias/scripts/bm.sh pipeline serve --role health
Restart=on-failure
RestartSec=10
TimeoutStopSec=150
KillMode=control-group

[Install]
WantedBy=default.target
