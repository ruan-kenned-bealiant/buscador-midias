[Unit]
Description=Buscador de mídias - agendador de rodadas e manutenção das filas
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/ruan-aliant/Documentos/Projetos/buscador-midias
ExecStart=/home/ruan-aliant/Documentos/Projetos/buscador-midias/scripts/bm.sh pipeline serve --role scheduler
Restart=on-failure
RestartSec=10
TimeoutStopSec=150
KillMode=control-group

[Install]
WantedBy=default.target
